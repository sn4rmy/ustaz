# Backend address. All API paths start with /api.
VITE_API_URL=http://localhost:8000

# Which API modules use test data instead of the backend:
#   all  - everything, the backend is not needed at all
#   none - everything goes to the backend
#   or a comma-separated list of: auth, courses, chat, items, billing
# By default only the parts the backend doesn't have yet are mocked.
VITE_MOCK_API=courses,chat,items,billing
