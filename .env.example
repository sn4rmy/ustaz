# Settings for `docker compose up`. Copy this file to .env and fill it in:
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env is in .gitignore, so real keys never reach git.

# Required. Any random string of at least 32 characters, for example the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# gemini, openrouter or fake. fake needs no key and answers with stub text.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# mock (no real payment) or paddle. Paddle setup: docs/payments.md.
PAYMENT_PROVIDER=mock
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
